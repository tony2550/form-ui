// Prisma 6 Schema for PDF AcroForm Filler

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions FormSubmission[]

  @@index([email])
}

model PdfTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  fileUrl     String   // Vercel Blob URL
  fileKey     String   // For deletion
  fieldSchema Json     // AcroForm fields metadata
  category    String   @default("general")
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions FormSubmission[]

  @@index([category])
  @@index([isActive])
}

enum SubmissionStatus {
  DRAFT
  COMPLETED
  SUBMITTED
  ARCHIVED
}

model FormSubmission {
  id              String           @id @default(cuid())
  userId          String
  templateId      String
  formData        Json             // User input data (Prisma 6: no Buffer)
  status          SubmissionStatus @default(DRAFT)
  completedPdfUrl String?
  completedPdfKey String?
  version         Int              @default(1)
  submittedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  template PdfTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([templateId])
  @@index([createdAt])
}
